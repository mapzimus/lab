/*
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(self), microphone=(), geolocation=(self)

# Packaged Claude skills: force download with a sensible filename.
/skills/files/*
  Content-Type: application/zip
  Content-Disposition: attachment

/data/*
  Cache-Control: public, max-age=3600

/styles.css
  Cache-Control: public, max-age=3600

/theme.js
  Cache-Control: public, max-age=3600

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/app.js
  Cache-Control: public, max-age=3600

/favicon.svg
  Cache-Control: public, max-age=86400

# Flipgame v1.11 is deliberately local-only and ships no telemetry. Prevent
# Cloudflare Web Analytics from injecting a RUM beacon into its HTML while
# retaining revalidation at the release boundary.
/flipgame/*
  Cache-Control: public, max-age=0, must-revalidate, no-transform

# Lab project assets. The data files are addressed with a ?v= version from
# app.js, so they can be cached hard; the code that points at them must not be,
# or a deploy leaves readers on a stale script for hours.
#
# The middle segment has to be a :placeholder, not a splat. Cloudflare Pages
# only honours a wildcard at the end of a path, so `/lab/*/data/*` matched
# nothing and every lab data file fell back to the Pages default of
# max-age=0, must-revalidate. Confirmed against a preview deploy.
/lab/:project/data/*
  Cache-Control: public, max-age=31536000, immutable

/lab/:project/app.js
  Cache-Control: public, max-age=0, must-revalidate

/lab/:project/vendor/*
  Cache-Control: public, max-age=31536000, immutable
